# Copy to .env and fill in. Never commit .env.
# MongoDB: a mongodb+srv:// Atlas URI (credentials may be omitted; injected from the two vars below) or any mongodb:// URI
MONGODB_URI=mongodb+srv://cluster0.xxxxx.mongodb.net
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=library_management
PORT=4000
NODE_ENV=production
# Long random string used to sign app JWTs (required in production)
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Comma-separated allowed frontend origins, e.g. https://your-app.vercel.app,http://localhost:3003
CORS_ORIGIN=http://localhost:3003,http://localhost:3001,http://localhost:5173
# Super admin (seeded on startup if missing). Use the Google account email that should own the platform.
SUPERADMIN_EMAIL=your-email@example.com
# Optional password-login fallback for the super admin. If empty and SUPERADMIN_CREDENTIALS_FILE is set,
# a strong password is generated and written there (0600). If both are empty, the account is Google-only.
SUPERADMIN_PASSWORD=
SUPERADMIN_CREDENTIALS_FILE=
# Google Identity Services OAuth client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Demo seed (npm run seed:demo)
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_CREDENTIALS_FILE=
